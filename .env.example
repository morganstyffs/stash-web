# Supabase — project "Stash" (region: Singapore)
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริงจาก Supabase Dashboard → Project Settings → API
# ห้าม commit ไฟล์ .env จริง (อยู่ใน .gitignore แล้ว)

# ทั้งสองค่านี้เป็น "build variable" — Vite อ่านตอน build (import.meta.env) แล้ว
# bundle เข้าไฟล์ static ดังนั้นบน Cloudflare ต้องตั้งไว้ที่ Workers Builds →
# Build variables (ไม่ใช่ runtime secret)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# หมายเหตุ: anon key ปลอดภัยที่จะอยู่ฝั่ง client เพราะทุกตารางบังคับ RLS (auth.uid() = user_id)
#
# --- AI proxy (ยังไม่ใช้ตอนนี้) ---
# ANTHROPIC_API_KEY เก็บเป็น runtime secret ฝั่ง server เท่านั้น
# (Cloudflare → Workers → stash-web → Settings → Variables and Secrets,
#  หรือ `npx wrangler secret put ANTHROPIC_API_KEY`)
# ห้ามใส่ AI key ที่ขึ้นต้นด้วย VITE_ เด็ดขาด เพราะจะถูก bundle ไปฝั่ง client
