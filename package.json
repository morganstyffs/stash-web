{
  "name": "stash-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Stash — personal expense tracker + resale stock management (mobile/tablet-first PWA, Thai UI)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b",
    "typecheck": "tsc -b",
    "cf:dev": "wrangler dev",
    "cf:typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@tabler/icons-react": "^3.28.1",
    "@tanstack/react-query": "^5.62.11",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
