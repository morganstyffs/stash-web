{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stash-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-07-01",
  "assets": {
    // Vite build output. `npm run build` must run before `wrangler deploy`.
    "directory": "./dist",
    // Binding used by the Worker to serve static files (env.ASSETS.fetch).
    "binding": "ASSETS",
    // Rewrite unknown paths to /index.html so the SPA (react-router) handles
    // client-side routing instead of returning 404.
    "not_found_handling": "single-page-application",
    // Run the Worker on EVERY request (including static-asset requests) so the
    // security-headers middleware in src/worker/index.ts wraps the HTML/JS/CSS
    // responses too — not just /api/*. Without this, Cloudflare serves assets
    // directly and the Worker (and its CSP) never runs for the document.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
